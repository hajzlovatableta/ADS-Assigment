@page "/posts/create"
@inject IPostService PostService
@inject NavigationManager NavMgr

<PageTitle>New post</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>New post</h1>
        <div class="card form">
            <label>Title:</label>
            <input type="text" @bind="title"/>
            <label>Body:</label>
            <textarea rows="6" @bind="body"></textarea>
            @if (!string.IsNullOrEmpty(errorLabel))
            {
                <label class="error">@errorLabel</label>
            }
            <button @onclick="CreateAsync">Create post</button>
        </div>
    </Authorized>
    <NotAuthorized>
        <h1>New post</h1>
        <p>You'll have to <a href="/login">log in</a> to write a post.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;

    private string title = "";
    private string body = "";
    private string errorLabel = "";

    private async Task CreateAsync()
    {
        errorLabel = "";
        AuthenticationState authState = await State;
        int? userId = authState.User.GetUserId();
        if (userId is null)
        {
            errorLabel = "You must be logged in.";
            return;
        }

        try
        {
            PostDto created = await PostService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserId = userId.Value // the logged-in user is the author
            });
            NavMgr.NavigateTo($"posts/{created.Id}");
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            errorLabel = $"Error: {e.Message}";
        }
    }
}
